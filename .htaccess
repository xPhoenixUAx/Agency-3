Options -Indexes -MultiViews
DirectoryIndex index.html
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule (^|/)\.(?!well-known(?:/|$)) - [F,END]
  RewriteRule ^(?:router\.php|DEPLOY\.md|api/site\.php)$ - [F,END]
  RewriteRule ^audit\.html$ index.html#audit [R=301,L,NE]
  RewriteRule ^(?:|(?:index|google-ads|tracking|results|privacy|terms|cookie-policy)\.html|robots\.txt|sitemap\.xml)$ api/page.php [END]
</IfModule>
<FilesMatch "^(server(?:\.example)?\.php|\.env.*)$">
  Require all denied
</FilesMatch>
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
